# =============================================================================
#  hubspot-mailer — Konfiguration
# =============================================================================
#
#  Diese Datei nach .env kopieren und ausfuellen. Die .env selbst gehoert
#  NICHT ins Git — sie steht in der .gitignore, und das soll so bleiben.
#
#  Auf dem Server ist eine Datei mit Rechten 600 in Ordnung. Wer mag, setzt
#  die Werte stattdessen als Umgebungsvariablen des Dienstes; gesetzte
#  Umgebungsvariablen gewinnen immer gegen diese Datei.
#
#  Pflichtfelder stehen oben. Alles darunter hat brauchbare Standardwerte.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. HubSpot
# -----------------------------------------------------------------------------
# Private App: HubSpot > Einstellungen > Integrationen > Private Apps.
# Benoetigte Scopes:
#   crm.objects.contacts.read     crm.objects.contacts.write
#   crm.objects.companies.read    crm.objects.companies.write
#   crm.objects.leads.read        crm.objects.leads.write      (falls vorhanden)
#   crm.schemas.contacts.write    crm.schemas.companies.write  (nur fuers Einrichten)
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Das Client-Secret derselben App — damit werden die Webhooks signiert.
# Zu finden im Reiter "Auth" der Private App.
HUBSPOT_WEBHOOK_SECRET=

# Alternative zum Token oben: OAuth mit Refresh-Token. Nur noetig, wenn die
# Automation spaeter mehrere Portale bedienen soll. Dann HUBSPOT_ACCESS_TOKEN
# leer lassen.
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REFRESH_TOKEN=


# -----------------------------------------------------------------------------
#  2. Google Workspace / Gmail
# -----------------------------------------------------------------------------
# service_account = Dienstkonto mit domainweiter Delegierung. Empfohlen:
#   laeuft ohne Benutzerinteraktion und ohne ablaufende Tokens.
# oauth          = Refresh-Token eines einzelnen Postfachs, falls keine
#   Workspace-Adminrechte vorliegen.
GOOGLE_AUTH_MODE=service_account

# Das vollstaendige JSON des Dienstkontos. Mehrzeiliges JSON ueberlebt
# .env-Dateien schlecht, deshalb base64:
#   base64 -w0 dienstkonto.json
GOOGLE_SERVICE_ACCOUNT=

# Nur bei GOOGLE_AUTH_MODE=oauth:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# Bei abgerissener Verbindung im Postausgang nachsehen, ob die Mail doch
# raus ist. Braucht zusaetzlich den Scope gmail.readonly in der Delegierung.
# Ohne diese Moeglichkeit landen unklare Faelle auf needs_review und warten
# auf einen Menschen — nie auf eine automatische Wiederholung.
GMAIL_VERIFY_ENABLED=false


# -----------------------------------------------------------------------------
#  3. Absender
# -----------------------------------------------------------------------------
GMAIL_SENDER_EMAIL=info@finanz-medizin.com
GMAIL_SENDER_NAME=Finanz & Medizin
GMAIL_REPLY_TO=info@finanz-medizin.com
# GMAIL_BCC=

SENDER_DEFAULT=info

# Mehrere Postfaecher — dann wird GMAIL_SENDER_* nicht gebraucht. Der
# Schluessel ("info", "akquise") ist das, was in der HubSpot-Property
# automation_email_sender steht und was eine Kampagne als Absender nennt.
# Einzeilig, ohne Umbrueche.
#
# Die zweite Domain ist fuer Kaltakquise gedacht: Wird sie bei einem Anbieter
# schlechter zugestellt, bleibt finanz-medizin.com davon unberuehrt — dort
# laeuft die Post an bestehende Mandanten. Die Absenderangaben nennen in
# beiden Faellen dieselbe echte Firma; es geht um Zustellbarkeit, nicht
# darum, zu verschleiern, wer schreibt. Siehe README, "Zweite Domain".
# SENDER_ACCOUNTS={"info":{"email":"info@finanz-medizin.com","name":"Finanz & Medizin","replyTo":"info@finanz-medizin.com"},"akquise":{"email":"benedict@fm-praxisteam.de","name":"Benedict Hintz | Finanz Medizin","replyTo":"info@finanz-medizin.com"}}


# -----------------------------------------------------------------------------
#  4. Server und Webhook
# -----------------------------------------------------------------------------
PORT=8080
HOST=127.0.0.1

# Die von aussen sichtbare Adresse. Geht in die Signaturpruefung ein und
# sollte hinter einem Reverse-Proxy unbedingt gesetzt sein.
PUBLIC_BASE_URL=https://automation.finanz-medizin.com

WEBHOOK_PATH=/hubspot/webhook
TRIGGER_PATH=/hubspot/trigger

# Geheimnis fuer /hubspot/trigger (Workflow-Webhooks, Handaufrufe, /metrics).
# Erzeugen mit:  openssl rand -base64 32
WEBHOOK_SHARED_SECRET=

# Nur zum Einrichten voruebergehend auf false stellen. Im Betrieb bleibt das an.
WEBHOOK_REQUIRE_SIGNATURE=true


# -----------------------------------------------------------------------------
#  5. Versand
# -----------------------------------------------------------------------------
SEND_MAX_ATTEMPTS=3
SEND_RETRY_BASE_MS=2000
SEND_RETRY_MAX_MS=60000

# Google Workspace erlaubt 2.000 Empfaenger je Tag und Postfach. Der Wert
# hier ist die eigene Notbremse, damit ein versehentlich massenhaft gesetztes
# Kennzeichen nicht das Kontingent verbrennt.
SEND_MAX_PER_MINUTE=30
SEND_DAILY_LIMIT=1500

# Alles durchlaufen, nur nicht wirklich senden.
DRY_RUN=false

# Sicherheitsnetz fuer Tests am echten Portal: Ist hier etwas eingetragen,
# geht Post ausschliesslich an diese Adressen oder @domains. Alles andere
# bekommt Status failed mit einem deutlichen Hinweis.
# SEND_ALLOWLIST=benedict.hintz@gmail.com,@finanz-medizin.com

# strict = fehlt der Wert zu einem benutzten Platzhalter, wird nicht gesendet.
# blank  = der Platzhalter wird leer eingesetzt.
PLACEHOLDER_POLICY=strict

SIGNATURE_ENABLED=true


# -----------------------------------------------------------------------------
#  5b. Kampagnen mit Nachfassmails
# -----------------------------------------------------------------------------
# Kampagnen liegen als Dateien in sequences/. Sie liefern Betreff und Text;
# die Freitextfelder am Datensatz werden dann nicht gelesen.
# SEQUENCE_DIR=/opt/hubspot-mailer/sequences

# Keine Nachfassmail, solange nicht nachgesehen werden kann, ob der
# Empfaenger geantwortet hat. Das ist der teuerste Fehler in der Kaltakquise:
# Wer antwortet und trotzdem zweimal nachgefasst wird, ist als Kunde weg und
# markiert die Mail als Spam. Braucht GMAIL_VERIFY_ENABLED=true und den Scope
# gmail.readonly. Nur abschalten, wenn die Abbrueche in HubSpot von Hand
# gepflegt werden.
SEQUENCE_REQUIRE_REPLY_CHECK=true

# Weitere Gruende, eine Kampagne zu stoppen — zusaetzlich zu denen, die in
# der Kampagnendatei selbst stehen.
SEQUENCE_STOP_IF={"lifecyclestage":["customer","opportunity"],"hs_lead_status":["CONNECTED","UNQUALIFIED"]}

# Einwilligungssperre. Solange diese Property nicht auf wahr steht, startet
# keine Kampagne. Dringend empfohlen fuer Kaltakquise — siehe README,
# Abschnitt "Bevor Sie kalt anschreiben". Der Name ist der Ihrer eigenen
# Property; die Funnels auf der Website erfassen die Einwilligung bereits.
# SEQUENCE_CONSENT_PROPERTY=einwilligung_kontaktaufnahme

# Kein Kampagnenversand ausserhalb dieser Ortszeit und dieser Wochentage.
# Geschaeftspost um drei Uhr nachts sieht nach Maschine aus und wird
# entsprechend einsortiert. Gilt nur fuer Kampagnen; eine angeforderte
# Einzelmail geht immer sofort raus. Leer = jederzeit.
SEQUENCE_SEND_WINDOW=8-17
SEQUENCE_SEND_DAYS=1,2,3,4,5

# Feste Werte, die in jeder Mail als Platzhalter zur Verfuegung stehen.
BOOKING_LINK=https://finanz-medizin.com/beratung
# EXTRA_PLACEHOLDERS={"telefon":"0176 43229851"}


# -----------------------------------------------------------------------------
#  6. Scheduler
# -----------------------------------------------------------------------------
# Holt geplante Mails ab und fischt heraus, was ein verlorener Webhook
# liegen gelassen hat.
POLL_ENABLED=true
POLL_INTERVAL_MS=60000
POLL_BATCH_SIZE=50
POLL_LOOKAHEAD_MS=30000

OBJECT_TYPES=contacts,companies,leads


# -----------------------------------------------------------------------------
#  7. Properties
# -----------------------------------------------------------------------------
# Nur aendern, wenn im Portal andere Namen gelten. Ein leerer Wert schaltet
# die Property ab; bei enabled, subject, body und status geht das nicht.
PROP_ENABLED=automation_email_enabled
PROP_SUBJECT=automation_email_subject
PROP_BODY=automation_email_body
PROP_SEND_AT=automation_send_at
PROP_STATUS=automation_email_status
PROP_SENT_AT=automation_email_sent_at
PROP_ID=automation_email_id
PROP_MESSAGE_ID=automation_email_message_id
PROP_ERROR=automation_email_error
PROP_ATTEMPTS=automation_email_attempts
PROP_SENDER=automation_email_sender
PROP_TEMPLATE=automation_email_template
PROP_RECIPIENT=automation_email_recipient
PROP_SEND_KEY=automation_email_send_key
PROP_MEETING_AT=automation_meeting_at
PROP_CONTACT_ID=automation_email_contact_id
PROP_SEQUENCE=automation_sequence
PROP_SEQUENCE_STEP=automation_sequence_step
PROP_SEQUENCE_STATUS=automation_sequence_status

# Auswahlmoeglichkeiten fuer automation_email_template.
TEMPLATE_OPTIONS=standard,erstinformation,terminbestaetigung,nachfass

# Eigene Platzhalter. Quellen: record:, contact:, company:, recipient:,
# sender:, meeting:, const:
# PLACEHOLDER_MAP={"praxis":"company:name","fachgebiet":"contact:fachgebiet","berater":"const:Benedict Hintz"}


# -----------------------------------------------------------------------------
#  8. Empfaengerermittlung
# -----------------------------------------------------------------------------
# true  = genau ein am Unternehmen verknuepfter Kontakt gilt als eindeutig.
# false = es muss immer eine Kontakt-ID in automation_email_contact_id stehen.
# Bei mehreren verknuepften Kontakten wird in beiden Faellen nicht gesendet.
RECIPIENT_SINGLE_CONTACT_FALLBACK=true


# -----------------------------------------------------------------------------
#  9. Ablage und Protokoll
# -----------------------------------------------------------------------------
# Das Verzeichnis muss dauerhaft und beschreibbar sein. Hier steht, was
# doppelte Mails verhindert — geht diese Datei verloren, ist der Schutz
# fuer die darin vermerkten Mails weg.
# STORE_FILE=/var/lib/hubspot-mailer/ledger.jsonl
STORE_COMPACT_LINES=20000
STORE_RETENTION_DAYS=400

LOG_LEVEL=info
# Betreffzeilen im Protokoll. Aus gutem Grund standardmaessig aus.
LOG_SUBJECTS=false
# LOG_FILE=


# -----------------------------------------------------------------------------
#  10. Sonstiges
# -----------------------------------------------------------------------------
TIMEZONE=Europe/Berlin
LOCALE=de-DE
WORKER_CONCURRENCY=1
# SIGNATURE_FILE=/opt/hubspot-mailer/templates/signature.html
# WRAPPER_FILE=/opt/hubspot-mailer/templates/wrapper.html
